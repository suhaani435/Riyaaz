# YouTube Data API v3 key — required for term-based search (video discovery).
# Create one at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first).
YOUTUBE_API_KEY=

# SQLite by default — zero setup. Swap for Postgres/Supabase later, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/riyaaz
DATABASE_URL=sqlite:///./riyaaz_search.db

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Max YouTube search results fetched per term query (keeps quota usage predictable)
MAX_CANDIDATE_VIDEOS=8
