# Local Docker Compose configuration. Copy this file to .env before starting.

# --- PostgreSQL ---
POSTGRES_DB=riyaaz
POSTGRES_USER=riyaaz
POSTGRES_PASSWORD=replace_with_a_local_secret
POSTGRES_PORT=5433

# --- API ---
API_PORT=8010
DATABASE_URL=postgresql+asyncpg://riyaaz:replace_with_a_local_secret@localhost:5433/riyaaz
CORS_ORIGINS=http://localhost:3010
LOG_LEVEL=INFO
ENVIRONMENT=local

# --- Web ---
WEB_PORT=3010
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010/api/v1

# --- Supabase (Phase 1 — fill in when project is created) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
